# Source pin for the Linux acceptance profile. Does not alter ordinary Android builds.
function(fetchkit_configure_pinned_curl)
    include(FetchContent)
    file(READ "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../third_party/curl.lock.json" fetchkit_curl_lock)
    string(JSON fetchkit_curl_url GET "${fetchkit_curl_lock}" url)
    string(JSON fetchkit_curl_hash GET "${fetchkit_curl_lock}" sha256)
    if(FETCHKIT_CURL_ARCHIVE)
        set(fetchkit_curl_url "${FETCHKIT_CURL_ARCHIVE}")
    endif()
    # Keep these overrides local to curl's subdirectory, including BUILD_TESTING.
    set(BUILD_CURL_EXE OFF)
    set(BUILD_SHARED_LIBS OFF)
    set(BUILD_STATIC_LIBS ON)
    # 静态 curl 也会随 FetchKit 链入宿主共享库；全部对象都需 PIC，避免 Linux 重定位链接失败。
    set(CMAKE_POSITION_INDEPENDENT_CODE ON)
    set(BUILD_TESTING OFF)
    set(BUILD_EXAMPLES OFF)
    set(BUILD_LIBCURL_DOCS OFF)
    set(BUILD_MISC_DOCS OFF)
    set(HTTP_ONLY ON)
    set(CURL_ENABLE_SSL ON)
    set(CURL_USE_OPENSSL ON)
    # curl's tri-state dependency macro writes cache entries (not option()).
    # Force only these curl-owned entries when this explicit minimal profile is selected.
    set(CURL_ZLIB OFF CACHE STRING "Pinned FetchKit curl profile" FORCE)
    set(CURL_BROTLI OFF CACHE STRING "Pinned FetchKit curl profile" FORCE)
    set(CURL_ZSTD OFF CACHE STRING "Pinned FetchKit curl profile" FORCE)
    set(CURL_USE_LIBPSL OFF)
    set(CURL_USE_LIBSSH2 OFF)
    set(CURL_USE_LIBSSH OFF)
    set(USE_LIBIDN2 OFF)
    set(USE_NGHTTP2 OFF)
    set(ENABLE_THREADED_RESOLVER ON)
    FetchContent_Declare(fetchkit_curl URL "${fetchkit_curl_url}" URL_HASH "SHA256=${fetchkit_curl_hash}")
    FetchContent_MakeAvailable(fetchkit_curl)
endfunction()
